# =============================================================================
#  Inception - non-secret configuration
# -----------------------------------------------------------------------------
#  This file contains ONLY non-sensitive configuration. Every password lives in
#  ../secrets/*.txt and is injected through Docker secrets, never through the
#  environment. See DEV_DOC.md ("Secrets vs environment variables").
# =============================================================================

# --- Host / identity ---------------------------------------------------------
LOGIN=chimex
DOMAIN_NAME=chimex.42.fr
DATA_PATH=/home/chimex/data

# --- MariaDB -----------------------------------------------------------------
MYSQL_HOST=mariadb
MYSQL_DATABASE=wordpress
MYSQL_USER=wp_user

# --- WordPress ---------------------------------------------------------------
WP_TITLE=Inception
WP_URL=https://chimex.42.fr
# The subject forbids "admin"/"administrator" in the administrator login.
WP_ADMIN_USER=site_owner
WP_ADMIN_EMAIL=site_owner@chimex.42.fr
WP_USER=chimex_editor
WP_USER_EMAIL=editor@chimex.42.fr

# --- Bonus: redis object cache ----------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# --- Bonus: FTP --------------------------------------------------------------
FTP_USER=ftp_user
FTP_PASV_MIN=21000
FTP_PASV_MAX=21010
