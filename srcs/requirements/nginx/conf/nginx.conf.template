# -----------------------------------------------------------------------------
#  WordPress vhost - the only server exposed by the mandatory part.
# -----------------------------------------------------------------------------
server {
    listen              443 ssl http2;
    listen              [::]:443 ssl;
    server_name         ${DOMAIN_NAME};

    ssl_certificate     /etc/nginx/ssl/inception.crt;
    ssl_certificate_key /etc/nginx/ssl/inception.key;

    # The subject allows TLSv1.2 and TLSv1.3 and nothing else. Everything
    # older (SSLv3, TLSv1.0, TLSv1.1) is therefore simply not listed.
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    root  /var/www/html;
    index index.php index.html;

    client_max_body_size 64M;

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    # PHP is handed over to the php-fpm container; no PHP runs inside nginx.
    location ~ \.php$ {
        try_files       $uri =404;
        include         fastcgi_params;
        fastcgi_pass    wordpress:9000;
        fastcgi_index   index.php;
        fastcgi_param   SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param   HTTPS on;
    }

    # Never serve the secrets WordPress keeps on disk.
    location ~ /\.(?!well-known) { deny all; }
    location = /wp-config.php    { deny all; }
}
